---
import { profile } from '../profile';
---
<footer class="site-footer">
  <span>© {new Date().getFullYear()} {profile.name} <span lang="zh-CN">{profile.chineseName}</span></span>
  <a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
</footer>
<style>
  .site-footer { max-width: 976px; margin: 0 auto; padding: 26px 0 38px; border-top: 1px solid var(--line); display: flex; justify-content: space-between; gap: 20px; color: var(--muted); font-size: 13px; }
  .site-footer a { color: var(--muted); text-decoration: none; }
  @media (max-width: 1040px) { .site-footer { margin: 0 32px; } }
  @media (max-width: 600px) { .site-footer { margin: 0 22px; flex-wrap: wrap; } }
</style>
