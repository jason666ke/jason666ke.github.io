---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { profile } from '../../profile';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<!doctype html>
<html lang="en">
  <head><BaseHead title={`Notes | ${profile.name}`} description={`Notes and writing by ${profile.name}.`} /></head>
  <body>
    <Header />
    <main id="main-content">
      <p class="eyebrow">THE NOTEBOOK</p>
      <h1>Notes & writing</h1>
      <p class="subtitle">A space for learning, ideas, and things I discover along the way.</p>
      <ul class="post-list">
        {posts.map((post) => (
          <li><a href={`/blog/${post.id}/`}>
            <div class="post-date"><FormattedDate date={post.data.pubDate} /></div>
            <h2 lang="zh-CN">{post.data.title}<span aria-hidden="true">↗</span></h2>
            <p lang="zh-CN">{post.data.description}</p>
          </a></li>
        ))}
      </ul>
      {posts.length === 0 && <p>No notes yet. Check back soon.</p>}
      <a href="/">← Back to homepage</a>
    </main>
    <Footer />
  </body>
</html>
<style>
  main { min-height: 70vh; padding-top: 60px; padding-bottom: 60px; }
  .eyebrow { font-size: 11px; letter-spacing: .16em; color: var(--accent); font-weight: 700; }
  h1 { font-family: Georgia, serif; font-weight: 400; }
  .subtitle { color: var(--muted); margin-top: 20px; }
  .post-list { padding: 0; list-style: none; margin: 40px 0; }
  li { border-top: 1px solid var(--line); padding: 25px 0; }
  li:last-child { border-bottom: 1px solid var(--line); }
  li a { display: block; text-decoration: none; }
  .post-date { font-size: 13px; color: var(--muted); }
  li h2 { font-size: 22px; margin-top: 12px; display: flex; justify-content: space-between; gap: 20px; }
  li h2 span { color: var(--accent); }
  li p { color: var(--muted); font-size: 15px; margin: 10px 0 0; }
  li a:hover h2 { color: var(--accent); }
</style>
